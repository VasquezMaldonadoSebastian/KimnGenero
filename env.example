NODE_ENV=development
PORT=3000
INDICATOR_REPOSITORY=memory
# Use only when INDICATOR_REPOSITORY=sqlite
SQLITE_DB_PATH=data/indicators.sqlite
# Comma-separated origins allowed in iframe elements.
IFRAME_ALLOWLIST=https://app.powerbi.com,https://*.powerbi.com,https://calendar.google.com
# Set to true only while validating CSP in a new environment.
CSP_REPORT_ONLY=false
# Set to 1 only when Express is behind one trusted reverse-proxy hop.
TRUST_PROXY=
